# Copy this file to .env and fill in real values before running docker compose.

# A long random secret used to sign JWTs — change this before deploying.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# The origin the browser uses to reach the frontend (used for CORS).
# In production: https://yourdomain.com
ALLOW_ORIGIN=http://localhost
